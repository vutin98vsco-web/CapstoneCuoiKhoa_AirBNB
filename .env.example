# Copy to .env.local and add the TokenCybersoft issued for your class.
# Never use NEXT_PUBLIC_ for this server-only credential.
CYBERSOFT_TOKEN=
SITE_URL=https://tnbnb.vercel.app

# Optional mail delivery. EMAIL_FROM must be verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Server-only bearer secret for the scheduled email retry endpoint.
CRON_SECRET=
# Used only on the server for the CyberSoft room/location catalog.
# Accounts, favorites, booking requests, reviews and admin remain in TNbnb.
# Verify real credentials with: npm run check:cybersoft

# PostgreSQL connection for Vercel/Neon. Server only. Takes priority over SQLite.
DATABASE_URL=

# Server-only SQLite path for accounts, sessions, favorites and bookings.
# Defaults to .data/tnbnb-bookings.sqlite. Preserve and back up this file.
TNB_BOOKINGS_DB_PATH=

# npm start only: listening address. Use a trusted HTTPS reverse proxy in production.
TNB_HOST=127.0.0.1
