# Copy to .env.local and add the TokenCybersoft issued for your class.
# Never use NEXT_PUBLIC_ for this server-only credential.
CYBERSOFT_TOKEN=

# Server-only SQLite path for accounts, sessions, favorites and bookings.
# Defaults to .data/tnbnb-bookings.sqlite. Preserve and back up this file.
TNB_BOOKINGS_DB_PATH=

# npm start only: listening address. Use a trusted HTTPS reverse proxy in production.
TNB_HOST=127.0.0.1
